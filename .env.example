# =============================================================================
# JAYARAM MITTAI STOREFRONT — ENVIRONMENT VARIABLES
# =============================================================================
# The frontend never talks to Supabase, Razorpay, or the backend's secrets
# directly — it only needs to know where the real NestJS backend is. This is
# a server-only variable (no NEXT_PUBLIC_ prefix): it's read exclusively by
# the proxy route (src/app/api/proxy/[...path]/route.ts), which forwards
# browser requests to the backend same-origin, so the backend's address
# never ships in the client bundle and CORS is never a concern.
#
# Razorpay's key id, Supabase credentials, JWT secrets, etc. all live in the
# BACKEND's own .env — none of them belong here.

BACKEND_API_URL=http://localhost:3001

# One deliberate exception to the "backend address never reaches the
# browser" rule above: the admin dashboard's live order-alert bell needs a
# direct WebSocket connection (a websocket upgrade can't be proxied through
# the plain HTTP route above). This is safe because the connection itself
# still requires a valid admin JWT (checked server-side), and only the
# staff-only /shop/admin/* pages ever load this — the public storefront
# never does. Leave it unset to just disable the live alert bell (the
# dashboard still works; new orders just won't ring until the next manual
# refresh).
NEXT_PUBLIC_ADMIN_WS_URL=http://localhost:3001
